{
  "name": "Retro Web Games",
  "description": "Turn any webpage into a retro game. Join with a PIN, play daily games, and compete on leaderboards.",
  "version": "0.1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Retro Web Games",
    "default_popup": "popup/popup.html"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/game-engine.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [],
      "matches": ["<all_urls>"]
    }
  ]
}


